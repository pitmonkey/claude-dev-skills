#!/usr/bin/env bash
set -euo pipefail
python3 - <<'PY'
import json
import subprocess
from pathlib import Path
paths = [Path('.claude-plugin/plugin.json'), Path('.codex-plugin/plugin.json')]
manifests = [json.loads(path.read_text()) for path in paths]
version = manifests[0]['version']
if any(item['version'] != version for item in manifests):
    raise SystemExit('Plugin versions differ; reconcile before committing')
parts = version.split('.')
if len(parts) != 3 or not all(part.isdecimal() for part in parts):
    raise SystemExit('Expected numeric major.minor.patch version')
major, minor, patch = map(int, parts)
new_version = f'{major}.{minor}.{patch + 1}'
for path, manifest in zip(paths, manifests):
    manifest['version'] = new_version
    path.write_text(json.dumps(manifest, indent=2) + '\n')
subprocess.run(['git', 'add', '--', *map(str, paths)], check=True)
print(f'Version bumped: {version} → {new_version}')
PY
